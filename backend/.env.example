# ============================================
# VERSIWORLD BACKEND ENVIRONMENT VARIABLES
# ============================================

# MongoDB Connection (REQUIRED)
# Get this from MongoDB Atlas or your local MongoDB instance
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/versaiworld?retryWrites=true&w=majority

# JWT Secrets (REQUIRED)
# Generate strong random strings (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_minimum_32_characters

# Email Configuration (REQUIRED for password reset)
# Gmail users: Use App Password (2FA enabled) or allow less secure apps
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Frontend URL (REQUIRED)
# For production: https://versaiworld.vercel.app
# For local: http://localhost:5173
FRONTEND_URL=https://versaiworld.vercel.app

# Node Environment (REQUIRED)
NODE_ENV=production

# Server Port (Optional, default: 5000)
PORT=5000

# ============================================
# OPTIONAL CONFIGURATIONS
# ============================================

# Cloudinary Configuration (for profile images)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Twilio Configuration (for SMS notifications)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone

# Stripe Configuration (for payments)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in all REQUIRED variables
# 3. Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Never commit .env file to git
# 5. Restart server after changes
# ============================================